# Copy to .env in MoneyManager.Api/ (or export these) before running outside Development.
# Configuration keys map to environment variables by replacing ":" with "__".

# Signing key for JWTs. Must be at least 32 bytes — the app refuses to start otherwise.
# Generate one with:  openssl rand -base64 48
JwtSettings__SecretKey=

# Optional overrides.
# JwtSettings__Issuer=MoneyManager.Api
# JwtSettings__Audience=MoneyManager.Client
# ConnectionStrings__Default=Data Source=moneymanager.db
# Cors__AllowedOrigins__0=http://localhost:5173
