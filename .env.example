# Copy to .env in MoneyManager.Api/ (or export these) before running outside Development.
# Configuration keys map to environment variables by replacing ":" with "__".

# Signing key for JWTs. Must be at least 32 bytes — the app refuses to start otherwise.
# Generate one with:  openssl rand -base64 48
JwtSettings__SecretKey=

# Whether POST /api/auth/register is reachable. Off unless set, so a deployment cannot leave
# registration open by forgetting to close it. appsettings.Development.json turns it on, so a
# local `dotnet run` can still create the first account without setting this.
# Auth__AllowRegistration=false

# Which sections of the product this deployment presents. Off means gone rather than hidden:
# the navigation drops the link and the endpoints answer 404, so a disabled section is
# indistinguishable from one that was never built.
#
# The defaults are the MVP shape — rental only — so a deployment needs none of these set.
# appsettings.Development.json turns everything on, so a local `dotnet run` shows the whole app.
# Features__Banking=false
# Features__Stocks=false
# Features__Loans=true
# Features__Events=true

# The one flag that hides no section. It gates the application's only outbound call: the European
# Central Bank's daily reference rates, fetched for the currency pairs the user has not entered
# themselves. On by default.
#
# Off is genuinely off — the provider is chosen before the container is built, so there is no
# HttpClient, no request and no DNS lookup. Set it for an air-gapped or egress-restricted
# deployment; totals then convert at whatever was typed into Settings, exactly as before.
#
# A rate the user entered is never overwritten by a fetched one, in either direction.
# Features__AutomaticExchangeRates=true

# Creates the first account, and a demo portfolio behind it, on a database that has neither.
# This is what makes a preview environment worth opening: a fresh volume starts empty, and with
# registration disabled there is otherwise no way in.
#
# Seed__Password has no default and startup fails without one — a built-in default would ship
# the same known credential to every environment built from this image.
# Seed__Enabled=true
# Seed__Username=demo
# Seed__Password=
# Seed__IncludeDemoData=true

# Optional overrides.
# JwtSettings__Issuer=MoneyManager.Api
# JwtSettings__Audience=MoneyManager.Client
# ConnectionStrings__Default=Data Source=moneymanager.db
# The trailing slash matters: HttpClient resolves the relative path against it.
# ExchangeRateProvider__BaseUrl=https://api.frankfurter.dev/v1/
# ExchangeRateProvider__TimeoutSeconds=5
# ExchangeRateProvider__CacheHours=6
# Cors__AllowedOrigins__0=http://localhost:5173
