# Copy to .env in MoneyManager.Api/ (or export these) before running outside Development.
# Configuration keys map to environment variables by replacing ":" with "__".

# Signing key for JWTs. Must be at least 32 bytes — the app refuses to start otherwise.
# Generate one with:  openssl rand -base64 48
JwtSettings__SecretKey=

# Whether POST /api/auth/register is reachable. Off unless set, so a deployment cannot leave
# registration open by forgetting to close it. appsettings.Development.json turns it on, so a
# local `dotnet run` can still create the first account without setting this.
# Auth__AllowRegistration=false

# Creates the first account, and a demo portfolio behind it, on a database that has neither.
# This is what makes a preview environment worth opening: a fresh volume starts empty, and with
# registration disabled there is otherwise no way in.
#
# Seed__Password has no default and startup fails without one — a built-in default would ship
# the same known credential to every environment built from this image.
# Seed__Enabled=true
# Seed__Username=demo
# Seed__Password=
# Seed__IncludeDemoData=true

# Optional overrides.
# JwtSettings__Issuer=MoneyManager.Api
# JwtSettings__Audience=MoneyManager.Client
# ConnectionStrings__Default=Data Source=moneymanager.db
# Cors__AllowedOrigins__0=http://localhost:5173
